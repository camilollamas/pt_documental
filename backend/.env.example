# Copiar a backend/.env para ejecución local. Los valores aquí son de ejemplo.

PORT=3000

# PostgreSQL de docker-compose.yml (usuario docs; contraseña por defecto docs_local, solo desarrollo).
DATABASE_URL=postgres://docs:docs_local@localhost:5432/documents
# Base usada por las pruebas e2e (las pruebas vacían sus tablas).
TEST_DATABASE_URL=postgres://docs:docs_local@localhost:5432/documents_test

# Redis de docker-compose.yml: cola de indexación (BullMQ). El número final es la base Redis.
REDIS_URL=redis://localhost:6379/0
# Base Redis de las pruebas e2e (se vacía en cada ejecución).
TEST_REDIS_URL=redis://localhost:6379/1
# Documentos que un worker indexa en paralelo.
INDEXING_CONCURRENCY=2
# Canal Redis Pub/Sub de los cambios de estado (worker → API → SSE). Pub/Sub ignora el número
# de base Redis: usar un canal distinto por entorno si varios comparten el mismo Redis.
EVENTS_CHANNEL=document-status

# Directorio donde se guardan los originales subidos (ignorado por Git).
STORAGE_DIR=./storage

# Tamaño máximo por archivo en bytes (inclusive). 10 MB = 10485760.
# El enunciado no fija un límite; 10 MB es la orientación acordada, ajustable por entorno.
MAX_UPLOAD_BYTES=10485760

# Máximo de archivos por lote en una sola mutación.
MAX_FILES_PER_UPLOAD=10

# --- Administrador único (obligatorio: la API no arranca sin estos valores) ---
ADMIN_USERNAME=admin
# Hash bcrypt de la contraseña, nunca la contraseña en claro. Generarlo con: npm run hash-password
# Mantener las comillas simples: el hash contiene "$".
# Valor de ejemplo: hash de "administrador123" (usuario admin), SOLO para desarrollo local.
# Es público: genere el suyo con npm run hash-password fuera de una prueba local.
ADMIN_PASSWORD_HASH='$2b$12$h9EwnWAe3vJDBptRerZxrOXeYY3Ob61AZbnHf5Bwgu4XDRx3i.yR.'
# Mínimo 32 caracteres. Valor de ejemplo público, solo para desarrollo local. Generar uno propio con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=alVZeZv5jFN5IEabSutv09eVDa392M0WLG-15DR7wxqgBmcitGzcsunam3zy2RhV
JWT_EXPIRES_IN=8h
# Intentos de login permitidos por IP y minuto.
LOGIN_MAX_ATTEMPTS_PER_MINUTE=5
